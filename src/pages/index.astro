---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation';
import Hero from '../components/Hero';
import ProblemSection from '../components/ProblemSection';
import Services from '../components/Services';
import About from '../components/About';
import Blog from '../components/Blog';
import Contact from '../components/Contact';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const pageTitle = "KI Automatisierung Frankfurt – KI Agentur für Rhein-Main";
const pageDescription = "KI Automatisierung Agentur Frankfurt: Workflows, Chatbots und Prozessautomatisierung für Unternehmen in Frankfurt und dem Rhein-Main-Gebiet. Persönliche Beratung, schnelle Umsetzung, messbare Ergebnisse.";

const posts = (await getCollection('blog')).map((p) => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  readTime: p.data.readTime,
  author: p.data.author,
  date: p.data.date,
  image: p.data.image || "/placeholder.svg"
}));
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image="/src/assets/ai-hero-image.jpg"
  type="website"
>
  <Navigation client:load />
  
  <main>
    <div id="hero">
      <Hero client:load />
    </div>
    
    <div id="problems">
      <ProblemSection client:load />
    </div>
    
    <div id="services">
      <Services client:load />
    </div>
    
    <!-- KI Automatisierung Frankfurt -->
    <section class="band-dark py-24 px-6">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-14">
        <div class="lg:col-span-6">
          <p class="text-sm font-semibold tracking-wide uppercase text-muted-foreground mb-4">Frankfurt &amp; Rhein-Main</p>
          <h2 class="text-3xl md:text-4xl leading-tight mb-6">KI Automatisierung Frankfurt</h2>
          <p class="text-lg leading-relaxed text-muted-foreground mb-5">
            Als KI Automatisierung Agentur aus Frankfurt automatisieren wir wiederkehrende Prozesse in Unternehmen im Rhein-Main-Gebiet – von einfachen Workflows bis zu komplexen KI-Agenten.
          </p>
          <p class="leading-relaxed text-muted-foreground mb-8">
            Typische Ergebnisse für Frankfurter Unternehmen: 20–50 % weniger manuelle Arbeit, schnellere Reaktionszeiten im Support, höhere Datenqualität – ohne zusätzliches Personal. Mit n8n, Make und OpenClaw bauen wir Lösungen, die sofort messbar wirken.
          </p>
          <ul class="border-b border-border">
            <li class="border-t border-border py-3 flex gap-3"><span aria-hidden="true">→</span><span>Support-Chatbots &amp; automatische Ticket-Vorsortierung</span></li>
            <li class="border-t border-border py-3 flex gap-3"><span aria-hidden="true">→</span><span>Dokumentenverarbeitung (Rechnungen, Verträge, Formulare)</span></li>
            <li class="border-t border-border py-3 flex gap-3"><span aria-hidden="true">→</span><span>E-Mail- &amp; Lead-Qualifizierungsworkflows</span></li>
            <li class="border-t border-border py-3 flex gap-3"><span aria-hidden="true">→</span><span>Marketing-Automation &amp; Content-Erstellung</span></li>
          </ul>
        </div>

        <dl class="lg:col-span-6 grid grid-cols-2 gap-x-8 gap-y-12 content-center">
          <div>
            <dd class="font-display text-5xl md:text-6xl text-highlight leading-none">20–50%</dd>
            <dt class="mt-3 text-muted-foreground max-w-[22ch]">weniger manuelle Arbeit in Routineaufgaben</dt>
          </div>
          <div>
            <dd class="font-display text-5xl md:text-6xl text-highlight leading-none">1–2 Wo.</dd>
            <dt class="mt-3 text-muted-foreground max-w-[22ch]">bis zum ersten lauffähigen Prototyp</dt>
          </div>
          <div>
            <dd class="font-display text-5xl md:text-6xl text-highlight leading-none">400+</dd>
            <dt class="mt-3 text-muted-foreground max-w-[22ch]">Integrationen mit n8n &amp; Make</dt>
          </div>
          <div>
            <dd class="font-display text-5xl md:text-6xl text-highlight leading-none">24/7</dd>
            <dt class="mt-3 text-muted-foreground max-w-[22ch]">automatisierte Prozesse ohne manuelle Eingriffe</dt>
          </div>
        </dl>
      </div>
    </section>

    <div id="about">
      <About client:load />
    </div>
    
    <div id="blog">
      <Blog client:load posts={posts} limit={3} showViewAll={true} layout="list" />
    </div>
    
    <div id="contact">
      <Contact client:load />
    </div>
  </main>

  <Footer />

  <!-- Additional Structured Data for Homepage -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "KI Frankfurt",
    "url": "https://frankfurt-ai.de",
    "description": pageDescription,
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://frankfurt-ai.de/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "KI Automatisierung Frankfurt",
    "serviceType": "KI-Automatisierung",
    "provider": {
      "@type": "Organization",
      "name": "Vivid AI Lab",
      "url": "https://frankfurt-ai.de",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Frankfurt am Main",
        "addressRegion": "Hessen",
        "addressCountry": "DE"
      }
    },
    "areaServed": [
      { "@type": "City", "name": "Frankfurt am Main" },
      { "@type": "AdministrativeArea", "name": "Rhein-Main-Gebiet" }
    ],
    "description": "KI Automatisierung Agentur Frankfurt: Workflows, Chatbots und Prozessautomatisierung für Unternehmen in Frankfurt und dem Rhein-Main-Gebiet.",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "KI-Automatisierungslösungen Frankfurt",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Workflow-Automatisierung Frankfurt" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Support-Chatbots Frankfurt" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Dokumentenverarbeitung Frankfurt" } }
      ]
    }
  })} />
</Layout>
