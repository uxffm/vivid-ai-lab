---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation';
import Contact from '../../components/Contact';
import Footer from '../../components/Footer.astro';

const pageTitle = "AI Consulting Frankfurt – Strategic AI Integration | Frankfurt AI";
const pageDescription = "Professional AI consulting in Frankfurt, Germany: we help you integrate artificial intelligence strategically into your business. Tailored advice for lasting results.";

const alternates = [
  { hreflang: "de", href: "/ki-beratung/" },
  { hreflang: "en", href: "/en/ai-consulting-frankfurt/" },
  { hreflang: "x-default", href: "/ki-beratung/" },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "AI consulting",
  "name": "AI Consulting Frankfurt",
  "description": pageDescription,
  "inLanguage": "en",
  "provider": {
    "@type": "Organization",
    "name": "KI Frankfurt",
    "url": "https://frankfurt-ai.de",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Frankfurt am Main",
      "addressRegion": "Hessen",
      "addressCountry": "DE"
    }
  },
  "areaServed": { "@type": "Country", "name": "Germany" },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "AI consulting services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI potential analysis", "description": "Identifying quick wins and strategic AI projects" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tool evaluation", "description": "Comparing AI platforms, APIs and custom solutions" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Process optimization", "description": "Automating routine tasks with AI support" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Change management", "description": "Preparing teams for AI-assisted workflows" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Pilot projects", "description": "Fast proofs of concept to validate business cases" } }
    ]
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image="/src/assets/ai-hero-image.jpg"
  type="website"
  customSchema={serviceSchema}
  lang="en"
  alternates={alternates}
>
  <Navigation client:load lang="en" altHref="/ki-beratung/" />

  <!-- Breadcrumbs -->
  <nav class="pt-32 pb-4" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-6">
      <ol class="flex items-center gap-2 text-sm text-muted-foreground" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/en/" itemprop="item" class="hover:text-foreground transition-colors">
            <span itemprop="name">Home</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li aria-hidden="true">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="text-foreground">AI Consulting</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center overflow-hidden band-brand">
      <div class="absolute inset-0 bg-background" />
      <div class="pointer-events-none absolute -top-24 -left-24 h-64 w-64 rounded-full bg-foreground/10 blur-2xl" />
      <div class="pointer-events-none absolute -bottom-24 -right-24 h-64 w-64 rounded-full bg-foreground/10 blur-2xl" />

      <div class="relative z-10 max-w-7xl mx-auto px-6">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-4xl md:text-6xl font-bold leading-tight">
            AI Consulting Frankfurt
          </h1>
          <p class="mt-6 text-lg md:text-xl text-muted-foreground">
            Strategic AI consulting for lasting business success. We analyze your business, identify potential and guide you from the first idea to successful implementation, with a clear focus on measurable results.
            Our approach: practical workshops, realistic roadmaps and hands-on support. We help you use AI tools sensibly and optimize your processes for the long term.
          </p>
          <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
            <a href="#kontakt" class="inline-flex items-center justify-center px-6 py-3 rounded-[5px] bg-primary text-primary-foreground transition-colors">
              Free initial consultation
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Intro Text -->
    <section class="py-16 bg-card">
      <div class="max-w-3xl mx-auto px-6">
        <div class="rounded-2xl border border-border/60 bg-foreground/5 backdrop-blur-sm p-8 shadow-lg text-center">
        <h2 class="text-2xl md:text-3xl font-semibold mb-4">What AI consulting brings to your business</h2>
        <div class="space-y-8 text-lg text-muted-foreground">
          <p>
            Together we develop a tailored AI strategy that fits your business goals. We focus on use cases with real ROI and support you through the entire implementation process, without unnecessary overhead.
          </p>
          <p>
            Transparency and pragmatism are our guiding principles: at any time you understand what is possible, what it costs and which results you can expect.
            We work iteratively, deliver results early and adjust the strategy based on real feedback.
          </p>
          <p>
            With our expertise in modern AI tools and platforms (OpenAI, Claude, Gemini, custom models), we help you find the right technology for your specific requirements.
            We pay attention to data protection, compliance and long-term maintainability.
          </p>
          <div>
            <h3 class="text-xl font-semibold mb-4 text-foreground">Typical consulting focus areas</h3>
            <ul class="space-y-3 text-left">
              <li class="p-4 rounded-lg border border-border bg-card">
                AI potential analysis: identifying quick wins and strategic projects.
              </li>
              <li class="p-4 rounded-lg border border-border bg-card">
                Tool evaluation: comparing AI platforms, APIs and custom solutions.
              </li>
              <li class="p-4 rounded-lg border border-border bg-card">
                Process optimization: automating routine tasks with AI support.
              </li>
              <li class="p-4 rounded-lg border border-border bg-card">
                Change management: preparing your teams for AI-assisted workflows.
              </li>
              <li class="p-4 rounded-lg border border-border bg-card">
                Pilot projects: fast proofs of concept to validate business cases.
              </li>
            </ul>
          </div>
          <p>
            Results: a clear roadmap, validated use cases, reduced risk, and a team that can use AI tools effectively.
          </p>
          <p>
            We document all findings, decisions and next steps transparently.
            That way you can always see why a recommendation was made and how to continue on your own.
          </p>
        </div>
        </div>
      </div>
      <!-- Wider three-step grid -->
      <div class="mt-12 max-w-5xl mx-auto px-6">
        <h3 class="text-xl font-semibold mb-4 text-foreground text-center">Our consulting process in three steps</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-left">
          <div class="p-6 rounded-lg border border-border bg-card">
            <div class="text-sm font-semibold text-muted-foreground mb-1">Step 1</div>
            <h4 class="text-3xl md:text-2xl font-semibold mb-2">Discovery workshop</h4>
            <div class="text-sm text-muted-foreground mb-3">We analyze your processes and goals and identify concrete AI potential.</div>
            <ul class="text-sm text-muted-foreground space-y-1 list-disc pl-4">
              <li>Analysis of existing workflows</li>
              <li>Identifying optimization potential</li>
              <li>Prioritization by ROI & effort</li>
            </ul>
          </div>
          <div class="p-6 rounded-lg border border-border bg-card">
            <div class="text-sm font-semibold text-muted-foreground mb-1">Step 2</div>
            <h4 class="text-3xl md:text-2xl font-semibold mb-2">Strategy & roadmap</h4>
            <div class="text-sm text-muted-foreground mb-3">Joint development of an AI strategy with concrete milestones.</div>
            <ul class="text-sm text-muted-foreground space-y-1 list-disc pl-4">
              <li>Detailed use case assessment</li>
              <li>Tool & technology recommendations</li>
              <li>Phased plan with quick wins</li>
            </ul>
          </div>
          <div class="p-6 rounded-lg border border-border bg-card">
            <div class="text-sm font-semibold text-muted-foreground mb-1">Step 3</div>
            <h4 class="text-3xl md:text-2xl font-semibold mb-2">Implementation & enablement</h4>
            <div class="text-sm text-muted-foreground mb-3">Support during rollout and training of your teams for lasting adoption.</div>
            <ul class="text-sm text-muted-foreground space-y-1 list-disc pl-4">
              <li>Pilot project support</li>
              <li>Team training & workshops</li>
              <li>Performance monitoring & optimization</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- More -->
    <section class="py-16 bg-card">
      <div class="max-w-6xl mx-auto px-6">
        <div class="rounded-2xl border border-border/60 bg-foreground/5 backdrop-blur-sm p-8 shadow-lg">
          <h2 class="text-2xl md:text-3xl font-semibold mb-6">More about our AI consulting</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-lg text-muted-foreground">
            <div class="space-y-6">
              <p>
                Our consulting is based on years of hands-on experience with AI projects across different industries.
                We know the typical pitfalls and what matters for successful AI integration.
              </p>
              <p>
                That means realistic expectations, focused use cases and a clear plan for step-by-step adoption.
                We avoid hype and concentrate on what really works and creates measurable value.
              </p>
              <p>
                Let's start with a quick win and scale systematically once success shows.
              </p>
              <h3 class="text-xl font-semibold text-foreground">Your benefits at a glance</h3>
              <ul class="list-disc pl-5 space-y-2">
                <li>Avoiding costly wrong decisions</li>
                <li>Faster ROI through focused implementation</li>
                <li>Proven tool & technology recommendations</li>
                <li>Team enablement for independent use</li>
                <li>Transparent documentation of all decisions</li>
              </ul>
            </div>
            <div class="space-y-6">
              <p>
                Examples: chatbot integration, document automation, predictive analytics,
                content generation, sentiment analysis, AI-assisted data analysis and custom AI agents.
              </p>
              <p>
                Compliance & security: we ensure GDPR compliance, data protection,
                audit trails and secure API usage. Your data stays protected, even with cloud services.
              </p>
              <p>
                Next steps: free initial call, discovery workshop, then iterative implementation.
                You decide after each phase whether and how to continue, without a long contract commitment.
              </p>
              <h3 class="text-xl font-semibold text-foreground">AI tools & platforms (excerpt)</h3>
              <ul class="list-disc pl-5 space-y-2">
                <li>OpenAI (GPT-4, GPT-o1, Embeddings, Whisper)</li>
                <li>Anthropic Claude (Claude 3.5 Sonnet, Haiku)</li>
                <li>Google (Gemini, Vertex AI)</li>
                <li>Vector databases (Pinecone, Weaviate, pgvector)</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <div id="kontakt">
      <Contact client:load lang="en" heading="Ready to transform your processes?" paragraphs={["Let's use the power of AI together to make your business in Frankfurt and beyond successful. Contact us for a free consultation."]} placeholder="Tell us about your project and how we can help..." />
    </div>
  </main>

  <Footer lang="en" altHref="/ki-beratung/" />
</Layout>
