---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Thank you" description="Thank you for your message" noindex={true} lang="en">
  <main class="min-h-[60vh] flex items-center justify-center px-6 py-24">
    <div class="max-w-xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Thank you for your message</h1>
      <p class="text-lg text-muted-foreground mb-8">
        We will get back to you shortly.
      </p>
      <a href="/en/" class="inline-flex items-center justify-center px-6 py-3 rounded-[5px] bg-primary text-primary-foreground transition-colors">
        Back to home page
      </a>
    </div>
  </main>
</Layout>
