---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation';
import Hero from '../../components/Hero';
import ProblemSection from '../../components/ProblemSection';
import Services from '../../components/Services';
import About from '../../components/About';
import Contact from '../../components/Contact';
import Footer from '../../components/Footer.astro';

const pageTitle = "AI Automation Frankfurt – AI Agency for the Rhine-Main Region | Frankfurt AI";
const pageDescription = "AI automation agency Frankfurt: workflows, chatbots and process automation for companies in Frankfurt and the Rhine-Main region. Personal consulting, fast implementation, measurable results.";

const alternates = [
  { hreflang: "de", href: "/" },
  { hreflang: "en", href: "/en/" },
  { hreflang: "x-default", href: "/" },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image="/src/assets/ai-hero-image.jpg"
  type="website"
  lang="en"
  alternates={alternates}
>
  <Navigation client:load lang="en" altHref="/" />

  <main>
    <div id="hero">
      <Hero client:load lang="en" />
    </div>

    <div id="problems">
      <ProblemSection client:load lang="en" />
    </div>

    <div id="services">
      <Services client:load lang="en" />
    </div>

    <!-- AI Automation Frankfurt -->
    <section class="band-dark py-24 px-6">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-14">
        <div class="lg:col-span-6">
          <p class="text-sm font-semibold tracking-wide uppercase text-muted-foreground mb-4">Frankfurt &amp; Rhine-Main</p>
          <h2 class="text-3xl md:text-4xl leading-tight mb-6">AI Automation Frankfurt</h2>
          <p class="text-lg leading-relaxed text-muted-foreground mb-5">
            As an AI automation agency from Frankfurt we automate recurring processes in companies in the Rhine-Main region, from simple workflows to complex AI agents.
          </p>
          <p class="leading-relaxed text-muted-foreground mb-8">
            Typical results for Frankfurt companies: 20–50% less manual work, faster response times in support, higher data quality, without additional staff. With n8n, Make and OpenClaw we build solutions with immediately measurable impact.
          </p>
          <ul class="border-b border-border">
            <li class="border-t border-border py-3 flex gap-3"><span aria-hidden="true">→</span><span>Support chatbots &amp; automatic ticket pre-sorting</span></li>
            <li class="border-t border-border py-3 flex gap-3"><span aria-hidden="true">→</span><span>Document processing (invoices, contracts, forms)</span></li>
            <li class="border-t border-border py-3 flex gap-3"><span aria-hidden="true">→</span><span>Email &amp; lead qualification workflows</span></li>
            <li class="border-t border-border py-3 flex gap-3"><span aria-hidden="true">→</span><span>Marketing automation &amp; content creation</span></li>
          </ul>
        </div>

        <dl class="lg:col-span-6 grid grid-cols-2 gap-x-8 gap-y-12 content-center">
          <div>
            <dd class="font-display text-5xl md:text-6xl text-highlight leading-none">20–50%</dd>
            <dt class="mt-3 text-muted-foreground max-w-[22ch]">less manual work in routine tasks</dt>
          </div>
          <div>
            <dd class="font-display text-5xl md:text-6xl text-highlight leading-none">1–2 wks</dd>
            <dt class="mt-3 text-muted-foreground max-w-[22ch]">to the first working prototype</dt>
          </div>
          <div>
            <dd class="font-display text-5xl md:text-6xl text-highlight leading-none">400+</dd>
            <dt class="mt-3 text-muted-foreground max-w-[22ch]">integrations with n8n &amp; Make</dt>
          </div>
          <div>
            <dd class="font-display text-5xl md:text-6xl text-highlight leading-none">24/7</dd>
            <dt class="mt-3 text-muted-foreground max-w-[22ch]">automated processes without manual intervention</dt>
          </div>
        </dl>
      </div>
    </section>

    <div id="about">
      <About client:load lang="en" />
    </div>

    <div id="contact">
      <Contact client:load lang="en" heading="Ready to transform your processes?" paragraphs={["Let's use the power of AI together to make your business in Frankfurt and beyond successful. Contact us for a free consultation."]} placeholder="Tell us about your project and how we can help..." />
    </div>
  </main>

  <Footer lang="en" altHref="/" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AI Automation Frankfurt",
    "serviceType": "AI automation",
    "inLanguage": "en",
    "provider": {
      "@type": "Organization",
      "name": "Vivid AI Lab",
      "url": "https://frankfurt-ai.de",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Frankfurt am Main",
        "addressRegion": "Hessen",
        "addressCountry": "DE"
      }
    },
    "areaServed": [
      { "@type": "City", "name": "Frankfurt am Main" },
      { "@type": "AdministrativeArea", "name": "Rhine-Main region" }
    ],
    "description": "AI automation agency Frankfurt: workflows, chatbots and process automation for companies in Frankfurt and the Rhine-Main region.",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "AI automation solutions Frankfurt",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Workflow automation Frankfurt" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Support chatbots Frankfurt" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Document processing Frankfurt" } }
      ]
    }
  })} />
</Layout>
