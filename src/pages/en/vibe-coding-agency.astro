---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation';
import Contact from '../../components/Contact';
import Footer from '../../components/Footer.astro';

const pageTitle = "Vibe Coding Agency – Smart Software with an AI Edge | Frankfurt AI";
const pageDescription = "Vibe coding agency: we build clever, AI-powered applications and automations, fast, modular and focused on results.";

const alternates = [
  { hreflang: "de", href: "/vibe-coding/" },
  { hreflang: "en", href: "/en/vibe-coding-agency/" },
  { hreflang: "x-default", href: "/vibe-coding/" },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Vibe coding",
  "name": "Vibe Coding Agency",
  "description": pageDescription,
  "inLanguage": "en",
  "provider": {
    "@type": "Organization",
    "name": "KI Frankfurt",
    "url": "https://frankfurt-ai.de",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Frankfurt am Main",
      "addressRegion": "Hessen",
      "addressCountry": "DE"
    }
  },
  "areaServed": { "@type": "Country", "name": "Germany" },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Vibe coding services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI-powered web apps", "description": "Web apps with Next/Astro, auth, data connections and UI kits" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Automated backends & APIs", "description": "Node/serverless backends with workflows and webhooks" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "RAG search & agents", "description": "Document pipelines and agent functions for existing systems" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Dashboards & integrations", "description": "Internal tools and CRM/ERP/Slack/HubSpot integrations" } }
    ]
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image="/src/assets/ai-hero-image.jpg"
  type="website"
  customSchema={serviceSchema}
  lang="en"
  alternates={alternates}
>
  <Navigation client:load lang="en" altHref="/vibe-coding/" />

  <!-- Breadcrumbs -->
  <nav class="pt-32 pb-4" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-6">
      <ol class="flex items-center gap-2 text-sm text-muted-foreground" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="hover:text-foreground transition-colors">
            <span itemprop="name">Home</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li aria-hidden="true">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="text-foreground">Vibe Coding</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center overflow-hidden band-brand">
      <div class="absolute inset-0 bg-background" />
      <div class="pointer-events-none absolute -top-24 -left-24 h-64 w-64 rounded-full bg-foreground/10 blur-2xl" />
      <div class="pointer-events-none absolute -bottom-24 -right-24 h-64 w-64 rounded-full bg-foreground/10 blur-2xl" />

      <div class="relative z-10 max-w-7xl mx-auto px-6">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-4xl md:text-6xl font-bold leading-tight">
            Vibe Coding Agency
          </h1>
          <p class="mt-6 text-lg md:text-xl text-muted-foreground">
            We build apps and workflows with a modern tech stack and AI, fast, modular and with a clear focus on results. From prototype to rollout.
            Our approach: small, fast sprints, clear scope management and clean handovers to your team. With tools like Cursor and Claude Code we noticeably speed up development and design processes, which lowers your costs.
          </p>
          <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
            <a href="#kontakt" class="inline-flex items-center justify-center px-6 py-3 rounded-[5px] bg-primary text-primary-foreground transition-colors">
              Free consultation
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Intro Text -->
    <section class="py-16 bg-card">
      <div class="max-w-3xl mx-auto px-6">
        <div class="rounded-2xl border border-border/60 bg-foreground/5 backdrop-blur-sm p-8 shadow-lg text-center">
        <h2 class="text-2xl md:text-3xl font-semibold mb-4">What vibe coding brings to your team</h2>
        <div class="space-y-8 text-lg text-muted-foreground">
          <p>
            We plan lean, develop iteratively and integrate your tools cleanly. The result is stable products with tangible benefits, without overhead.
            We pay attention to clear responsibilities, short feedback loops and traceable decisions.
          </p>
          <p>
            Technically we rely on proven patterns (API-first, events, background jobs) and keep the architecture as simple as possible.
            This reduces complexity and makes maintenance, onboarding and future extensions easier.
          </p>
          <p>
            By using Cursor (pair programming in the IDE) and Claude Code (context-rich code assistance) we shorten iterations, generate boilerplate faster and test earlier.
            Design processes (copy, components, variants) also run faster and more consistently.
          </p>
          <div>
            <h3 class="text-xl font-semibold mb-4 text-foreground">Typical projects</h3>
            <ul class="space-y-3 text-left">
              <li class="p-4 rounded-lg border border-border bg-card">
                AI-powered web apps (Next/Astro) with auth, data connections and UI kits.
              </li>
              <li class="p-4 rounded-lg border border-border bg-card">
                Automated backends & APIs (Node/serverless) with workflows and webhooks.
              </li>
              <li class="p-4 rounded-lg border border-border bg-card">
                RAG search, document pipelines and agent functions for existing systems.
              </li>
              <li class="p-4 rounded-lg border border-border bg-card">
                Dashboards, internal tools and integrations (CRM, ERP, Slack, HubSpot).
              </li>
              <li class="p-4 rounded-lg border border-border bg-card">
                UX modernization: fast interfaces, clear information architecture.
              </li>
            </ul>
          </div>
          <p>
            Results: shorter time-to-value, less maintenance, clear ownership, and a product that feels good.
          </p>
          <p>
            Transparency matters to us: you can see the roadmap, velocity and open items at any time. On request we set up CI/CD, tests and monitoring
            so that releases run safely and reproducibly.
          </p>
        </div>
        </div>
      </div>
      <!-- Wider three-step grid -->
      <div class="mt-12 max-w-5xl mx-auto px-6">
        <h3 class="text-xl font-semibold mb-4 text-foreground text-center">Our approach in three steps</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-left">
          <div class="p-6 rounded-lg border border-border bg-card">
            <div class="text-sm font-semibold text-muted-foreground mb-1">Step 1</div>
            <h4 class="text-3xl md:text-2xl font-semibold mb-2">Analysis workshop</h4>
            <div class="text-sm text-muted-foreground mb-3">We clarify goals, users and interfaces, and define the MVP.</div>
            <ul class="text-sm text-muted-foreground space-y-1 list-disc pl-4">
              <li>User flows and requirements</li>
              <li>System interfaces & data</li>
              <li>MVP scope & roadmap</li>
            </ul>
          </div>
          <div class="p-6 rounded-lg border border-border bg-card">
            <div class="text-sm font-semibold text-muted-foreground mb-1">Step 2</div>
            <h4 class="text-3xl md:text-2xl font-semibold mb-2">Prototyping</h4>
            <div class="text-sm text-muted-foreground mb-3">Clickable prototype or functional POC in 1–2 weeks.</div>
            <ul class="text-sm text-muted-foreground space-y-1 list-disc pl-4">
              <li>UI/UX prototype or tech POC</li>
              <li>Real data & feedback loops</li>
              <li>Validation of the architecture</li>
            </ul>
          </div>
          <div class="p-6 rounded-lg border border-border bg-card">
            <div class="text-sm font-semibold text-muted-foreground mb-1">Step 3</div>
            <h4 class="text-3xl md:text-2xl font-semibold mb-2">Rollout & training</h4>
            <div class="text-sm text-muted-foreground mb-3">Clean handover, documentation and enablement of your team.</div>
            <ul class="text-sm text-muted-foreground space-y-1 list-disc pl-4">
              <li>Stable deployments & monitoring</li>
              <li>Docs, handover & training</li>
              <li>Support & further development</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- More -->
    <section class="py-16 bg-card">
      <div class="max-w-6xl mx-auto px-6">
        <div class="rounded-2xl border border-border/60 bg-foreground/5 backdrop-blur-sm p-8 shadow-lg">
          <h2 class="text-2xl md:text-3xl font-semibold mb-6">More about vibe coding</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-lg text-muted-foreground">
            <div class="space-y-6">
              <p>
                We rely on clear architecture, reusable components and a sensible dose of AI, where it creates real value.
              </p>
              <p>
                That means fast releases, fewer bugs and a code foundation that is easy to extend. We document key decisions and
                keep complex areas understandable with short architecture notes.
              </p>
              <p>
                Let's start small and pragmatic, and scale when the benefit shows.
              </p>
              <h3 class="text-xl font-semibold text-foreground">Your benefits at a glance</h3>
              <ul class="list-disc pl-5 space-y-2">
                <li>Fast MVPs, early user feedback</li>
                <li>Clean integrations & performance</li>
                <li>Maintainable code & clear ownership</li>
                <li>Scalable, feature by feature</li>
                <li>Lower costs through AI-assisted implementation (Cursor/Claude Code)</li>
              </ul>
            </div>
            <div class="space-y-6">
              <p>
                Examples: app frontend with auth, API backend with jobs/webhooks,
                vector search (RAG), agents, PDF pipelines, dashboards and CRM integrations.
              </p>
              <p>
                Security & quality: role permissions, audits, tests (unit/E2E), observability
                and guardrails for reliable AI. We use linters, previews and checklists before go-live.
              </p>
              <p>
                Next steps: conversation, short workshop, POC in 1–2 weeks.
                After that we grow in a targeted way, with clear milestones and effort estimates.
              </p>
              <h3 class="text-xl font-semibold text-foreground">Tech & tools (excerpt)</h3>
              <ul class="list-disc pl-5 space-y-2">
                <li>Astro/Next.js, React, Tailwind, Shadcn UI</li>
                <li>Node/serverless, edge functions, background jobs</li>
                <li>Postgres/Prisma, vector DB (e.g. Pinecone/pgvector)</li>
                <li>CI/CD (GitHub Actions), tests (Vitest/Playwright)</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <div id="kontakt">
      <Contact client:load lang="en" heading="Ready to transform your processes?" paragraphs={["Let's use the power of AI together to make your business in Frankfurt and beyond successful. Contact us for a free consultation."]} placeholder="Tell us about your project and how we can help..." />
    </div>
  </main>

  <Footer lang="en" altHref="/vibe-coding/" />
</Layout>
