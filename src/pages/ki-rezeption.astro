---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation';
import Contact from '../components/Contact';
import Footer from '../components/Footer.astro';

const pageTitle = "KI Rezeption & Sekretariat – Intelligente Anrufannahme für Ihr Unternehmen | KI Agentur";
const pageDescription = "KI-gestützte Rezeption und Sekretariat: 24/7 erreichbar, nie krank, immer freundlich. Automatische Anrufannahme, Terminbuchung und Kundenbetreuung mit künstlicher Intelligenz.";
const pageImage = "/ki-rezeption-sekretariat.png";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "KI Rezeption & Sekretariat",
  "name": "KI Rezeption für Unternehmen",
  "description": pageDescription,
  "provider": {
    "@type": "Organization",
    "name": "KI Frankfurt",
    "url": "https://frankfurt-ai.de",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Frankfurt am Main",
      "addressRegion": "Hessen",
      "addressCountry": "DE"
    }
  },
  "areaServed": {
    "@type": "Country",
    "name": "Deutschland"
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  type="website"
  customSchema={serviceSchema}
>
  <Navigation client:load />

  <!-- Breadcrumbs -->
  <nav class="pt-32 pb-4" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-6">
      <ol class="flex items-center gap-2 text-sm text-muted-foreground" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="hover:text-foreground transition-colors">
            <span itemprop="name">Home</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li aria-hidden="true">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="text-foreground">KI Rezeption</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <main>
    <!-- Hero -->
    <section class="relative py-20 overflow-hidden band-brand">
      <div class="absolute inset-0 bg-background" />
      <div class="pointer-events-none absolute -top-24 -left-24 h-64 w-64 rounded-full bg-foreground/10 blur-2xl" />
      <div class="pointer-events-none absolute -bottom-24 -right-24 h-64 w-64 rounded-full bg-foreground/10 blur-2xl" />

      <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
        <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-6">
          KI Rezeption & Sekretariat für Unternehmen
        </h1>
        <p class="text-2xl md:text-3xl font-semibold text-foreground mb-6">
          Ihre Rezeption ist 24/7 besetzt.<br />
          Ohne Krankheitstage, ohne Wartezeiten.
        </p>
        <p class="text-lg md:text-xl text-muted-foreground mb-8 max-w-3xl mx-auto">
          Wir implementieren eine KI-gestützte Telefonzentrale, die Anrufe professionell entgegennimmt, Termine bucht, Fragen beantwortet und Ihre Kunden begeistert – rund um die Uhr, 365 Tage im Jahr.
        </p>
        <p class="text-xl md:text-2xl font-semibold text-foreground mb-8">
          Intelligente Anrufannahme – persönlich, effizient, skalierbar.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#kontakt" class="inline-flex items-center justify-center px-8 py-4 rounded-lg bg-primary text-primary-foreground hover:from-green-600 hover:to-orange-500 transition-all text-lg font-semibold shadow-lg">
            Jetzt Strategiegespräch buchen →
          </a>
        </div>
      </div>
    </section>

    <!-- Barriers Section -->
    <section class="py-20 bg-card">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
          Kennen Sie diese Herausforderungen im Sekretariat?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-8 rounded-2xl border border-border bg-card backdrop-blur-sm">
            <h3 class="text-xl font-bold mb-3 text-foreground">📞 Verpasste Anrufe</h3>
            <p class="text-foreground">
              Während Meetings, nach Feierabend oder im Urlaub gehen wichtige Kundenanrufe verloren – und damit potenzielle Aufträge.
            </p>
          </div>
          <div class="p-8 rounded-2xl border border-border bg-card backdrop-blur-sm">
            <h3 class="text-xl font-bold mb-3 text-foreground">💰 Hohe Personalkosten</h3>
            <p class="text-foreground">
              Eine Vollzeit-Rezeptionskraft kostet 40.000€+ pro Jahr – plus Krankheitsausfälle, Urlaub und Sozialabgaben.
            </p>
          </div>
          <div class="p-8 rounded-2xl border border-border bg-card backdrop-blur-sm">
            <h3 class="text-xl font-bold mb-3 text-foreground">⏰ Begrenzte Erreichbarkeit</h3>
            <p class="text-foreground">
              Kunden erwarten heute 24/7-Erreichbarkeit. Aber wer kann sich schon Schichtbetrieb leisten?
            </p>
          </div>
          <div class="p-8 rounded-2xl border border-border bg-card backdrop-blur-sm">
            <h3 class="text-xl font-bold mb-3 text-foreground">📋 Manuelle Prozesse</h3>
            <p class="text-foreground">
              Terminbuchungen, Rückrufnotizen, Weiterleitungen – alles manuell. Fehleranfällig und zeitintensiv.
            </p>
          </div>
        </div>
        <div class="text-center mt-12">
          <p class="text-2xl font-bold text-foreground mb-4">Die Lösung: Eine KI, die für Sie ans Telefon geht.</p>
          <p class="text-lg text-muted-foreground max-w-3xl mx-auto">
            Moderne Sprach-KI versteht natürliche Sprache, führt echte Gespräche und erledigt Aufgaben – von der Terminbuchung bis zur Beantwortung komplexer Fragen. Und sie lernt mit jedem Anruf dazu.
          </p>
        </div>
      </div>
    </section>

    <!-- Case Study Section -->
    <section class="pt-0 pb-20">
      <div class="max-w-5xl mx-auto px-6">
        <div class="p-8 md:p-12 rounded-2xl border-2 border-primary/20 bg-foreground/5">
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-foreground">
            Case Study: Nie wieder einen Anruf verpassen
          </h2>

          <div class="mb-8">
            <h3 class="text-2xl font-bold mb-4 text-foreground">Das Problem:</h3>
            <p class="text-muted-foreground">
              Eine Arztpraxis mit 3 Ärzten verpasste täglich durchschnittlich 40 Anrufe während der Sprechstunden. Die Rezeption war überlastet, Patienten frustriert, und neue Patienten gingen zur Konkurrenz.
            </p>
          </div>

          <div class="mb-8">
            <h3 class="text-2xl font-bold mb-4 text-foreground">Die Lösung:</h3>
            <p class="text-muted-foreground">
              Wir haben eine KI-Rezeption implementiert, die Anrufe entgegennimmt, Termine direkt im Praxissystem bucht, Rezeptanfragen aufnimmt und nur dringende Fälle durchstellt – alles in natürlichem Deutsch.
            </p>
          </div>

          <div class="mb-8">
            <h3 class="text-2xl font-bold mb-6 text-foreground">Das Ergebnis:</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div class="p-6 rounded-xl bg-card backdrop-blur-sm">
                <div class="text-3xl font-bold text-gradient mb-2">📞 100% Erreichbarkeit</div>
                <p class="text-muted-foreground">
                  Kein Anruf geht mehr verloren – auch nicht um 22 Uhr oder am Wochenende.
                </p>
              </div>
              <div class="p-6 rounded-xl bg-card backdrop-blur-sm">
                <div class="text-3xl font-bold text-gradient mb-2">⏱️ 70% Zeitersparnis</div>
                <p class="text-muted-foreground">
                  Die Rezeption kann sich auf Patienten vor Ort konzentrieren.
                </p>
              </div>
              <div class="p-6 rounded-xl bg-card backdrop-blur-sm">
                <div class="text-3xl font-bold text-gradient mb-2">📈 +25% Neupatienten</div>
                <p class="text-muted-foreground">
                  Durch sofortige Terminvergabe statt besetzter Leitung.
                </p>
              </div>
            </div>
          </div>

          <div class="mt-8 p-6 rounded-xl bg-foreground/5 border border-primary/30">
            <p class="text-lg italic text-foreground text-center">
              „Unsere Patienten denken, wir hätten eine neue Mitarbeiterin eingestellt. Dabei ist es eine KI, die nie Pause macht."
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Me Section -->
    <section class="py-20">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-8">
          Warum wir Ihre KI-Rezeption implementieren
        </h2>
        <div class="text-center mb-12">
          <p class="text-xl text-muted-foreground">
            Wir sind Ihr Team. Wir sorgen dafür, dass Ihre telefonische Erreichbarkeit nicht mehr vom Personal abhängt, sondern von intelligenter Technologie.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl border border-border bg-foreground/5">
            <h3 class="text-lg font-bold mb-3 text-foreground">NATÜRLICHE GESPRÄCHE</h3>
            <p class="text-muted-foreground text-sm">
              Unsere KI klingt nicht wie ein Roboter. Sie versteht Dialekte, Unterbrechungen und komplexe Anfragen – und antwortet natürlich.
            </p>
          </div>
          <div class="p-6 rounded-2xl border border-border bg-foreground/5">
            <h3 class="text-lg font-bold mb-3 text-foreground">NAHTLOSE INTEGRATION</h3>
            <p class="text-muted-foreground text-sm">
              Wir verbinden die KI mit Ihrem Kalender, CRM, Praxissoftware oder Ticketsystem. Alles läuft automatisch zusammen.
            </p>
          </div>
          <div class="p-6 rounded-2xl border border-border bg-foreground/5">
            <h3 class="text-lg font-bold mb-3 text-foreground">KONTINUIERLICHE OPTIMIERUNG</h3>
            <p class="text-muted-foreground text-sm">
              Die KI lernt aus jedem Gespräch. Wir analysieren regelmäßig die Performance und optimieren die Gesprächsführung.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Solutions Section -->
    <section class="py-20 bg-card">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
          Was Ihre KI-Rezeption alles kann
        </h2>
        <div class="space-y-8">
          <div class="p-8 rounded-2xl border border-border bg-card backdrop-blur-sm">
            <h3 class="text-2xl font-bold mb-4 text-foreground">Intelligente Anrufannahme</h3>
            <p class="text-muted-foreground mb-4">
              Die KI begrüßt Anrufer persönlich, erkennt den Grund des Anrufs und leitet entsprechend weiter – oder erledigt die Anfrage direkt selbst.
            </p>
          </div>
          <div class="p-8 rounded-2xl border border-border bg-card backdrop-blur-sm">
            <h3 class="text-2xl font-bold mb-4 text-foreground">Automatische Terminbuchung</h3>
            <p class="text-muted-foreground mb-4">
              Direkte Integration in Ihren Kalender. Die KI prüft Verfügbarkeiten, schlägt Termine vor und bestätigt die Buchung – inklusive automatischer Erinnerungs-SMS.
            </p>
          </div>
          <div class="p-8 rounded-2xl border border-border bg-card backdrop-blur-sm">
            <h3 class="text-2xl font-bold mb-4 text-foreground">FAQ & Informationsauskunft</h3>
            <p class="text-muted-foreground mb-4">
              Öffnungszeiten, Anfahrt, Preise, Leistungen – die KI beantwortet alle Standardfragen sofort und entlastet Ihr Team.
            </p>
          </div>
          <div class="p-8 rounded-2xl border border-border bg-card backdrop-blur-sm">
            <h3 class="text-2xl font-bold mb-4 text-foreground">Intelligente Weiterleitung</h3>
            <p class="text-muted-foreground mb-4">
              Dringende Anliegen werden sofort durchgestellt. Alles andere wird dokumentiert und als Aufgabe erstellt – Sie behalten die Kontrolle.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparison Table -->
    <section class="py-20">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
          Der Fakten-Check: KI-Rezeption vs. Traditionell
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr class="border-b-2 border-border">
                <th class="text-left p-4 font-bold text-foreground">Faktor</th>
                <th class="text-left p-4 font-bold text-foreground">Klassische Rezeption</th>
                <th class="text-left p-4 font-bold text-foreground bg-foreground/5">KI-Rezeption</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr>
                <td class="p-4 font-semibold">Erreichbarkeit</td>
                <td class="p-4 text-muted-foreground">Mo-Fr, 9-17 Uhr (mit Pausen)</td>
                <td class="p-4 text-foreground bg-foreground/5">24/7/365 – immer erreichbar</td>
              </tr>
              <tr>
                <td class="p-4 font-semibold">Kosten/Monat</td>
                <td class="p-4 text-muted-foreground">3.500€+ (Gehalt, Sozialabgaben)</td>
                <td class="p-4 text-foreground bg-foreground/5">Ab 299€/Monat</td>
              </tr>
              <tr>
                <td class="p-4 font-semibold">Ausfallzeiten</td>
                <td class="p-4 text-muted-foreground">Urlaub, Krankheit, Kündigungen</td>
                <td class="p-4 text-foreground bg-foreground/5">Keine – 99,9% Uptime</td>
              </tr>
              <tr>
                <td class="p-4 font-semibold">Skalierbarkeit</td>
                <td class="p-4 text-muted-foreground">Begrenzt durch Personal</td>
                <td class="p-4 text-foreground bg-foreground/5">Unbegrenzt parallel</td>
              </tr>
              <tr>
                <td class="p-4 font-semibold">Wartezeit</td>
                <td class="p-4 text-muted-foreground">Bei Stoßzeiten oft Warteschleife</td>
                <td class="p-4 text-foreground bg-foreground/5">Sofortige Annahme</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="py-20 bg-card">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
          So implementieren wir Ihre KI-Rezeption
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary flex items-center justify-center text-primary-foreground text-2xl font-bold mx-auto mb-4">
              1
            </div>
            <h3 class="text-xl font-bold mb-3 text-foreground">ANALYSE</h3>
            <p class="text-muted-foreground">
              Wir analysieren Ihre typischen Anrufe, häufige Fragen und bestehende Systeme. Daraus entwickeln wir den optimalen Gesprächsablauf.
            </p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary flex items-center justify-center text-primary-foreground text-2xl font-bold mx-auto mb-4">
              2
            </div>
            <h3 class="text-xl font-bold mb-3 text-foreground">IMPLEMENTIERUNG</h3>
            <p class="text-muted-foreground">
              Wir trainieren die KI auf Ihre Anforderungen, integrieren Ihre Systeme und testen ausgiebig mit echten Szenarien.
            </p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 rounded-full bg-primary flex items-center justify-center text-primary-foreground text-2xl font-bold mx-auto mb-4">
              3
            </div>
            <h3 class="text-xl font-bold mb-3 text-foreground">GO-LIVE & OPTIMIERUNG</h3>
            <p class="text-muted-foreground">
              Nach dem Go-Live überwachen wir die Performance, analysieren Gespräche und optimieren kontinuierlich für beste Ergebnisse.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 bg-card">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
          Häufig gestellte Fragen zur KI-Rezeption
        </h2>
        <div class="space-y-6">
          <details open class="group p-6 rounded-2xl border border-border bg-card backdrop-blur-sm">
            <summary class="cursor-pointer font-bold text-lg text-foreground list-none flex items-center justify-between">
              <span>Merken Anrufer, dass sie mit einer KI sprechen?</span>
              <span class="transition-transform group-open:rotate-180">▼</span>
            </summary>
            <div class="mt-4 text-muted-foreground">
              Moderne Sprach-KI klingt erstaunlich natürlich. Die meisten Anrufer merken keinen Unterschied zu einem menschlichen Gesprächspartner. Die KI kann Dialekte verstehen, auf Unterbrechungen reagieren und natürlich antworten. Auf Wunsch kann sie sich auch als KI-Assistent vorstellen – das schafft Transparenz und wird von vielen Kunden positiv aufgenommen.
            </div>
          </details>

          <details open class="group p-6 rounded-2xl border border-border bg-card backdrop-blur-sm">
            <summary class="cursor-pointer font-bold text-lg text-foreground list-none flex items-center justify-between">
              <span>Was passiert bei komplexen Anfragen?</span>
              <span class="transition-transform group-open:rotate-180">▼</span>
            </summary>
            <div class="mt-4 text-muted-foreground">
              Die KI erkennt automatisch, wenn eine Anfrage ihre Fähigkeiten übersteigt oder persönliche Beratung erfordert. In solchen Fällen verbindet sie direkt zu einem Mitarbeiter durch, nimmt eine detaillierte Nachricht auf oder vereinbart einen Rückruf. Sie behalten immer die volle Kontrolle über die Eskalationsregeln.
            </div>
          </details>

          <details open class="group p-6 rounded-2xl border border-border bg-card backdrop-blur-sm">
            <summary class="cursor-pointer font-bold text-lg text-foreground list-none flex items-center justify-between">
              <span>Wie sicher sind meine Kundendaten?</span>
              <span class="transition-transform group-open:rotate-180">▼</span>
            </summary>
            <div class="mt-4 text-muted-foreground">
              Datenschutz hat höchste Priorität. Alle Gespräche werden verschlüsselt übertragen und verarbeitet. Auf Wunsch können wir die Lösung komplett in Ihrer eigenen Infrastruktur betreiben – dann verlassen keine Daten Ihr Unternehmen. Selbstverständlich ist alles DSGVO-konform.
            </div>
          </details>

          <details open class="group p-6 rounded-2xl border border-border bg-card backdrop-blur-sm">
            <summary class="cursor-pointer font-bold text-lg text-foreground list-none flex items-center justify-between">
              <span>Welche Systeme können integriert werden?</span>
              <span class="transition-transform group-open:rotate-180">▼</span>
            </summary>
            <div class="mt-4 text-muted-foreground">
              Praktisch alle! Von Google Calendar über Microsoft 365, Salesforce, HubSpot bis hin zu branchenspezifischen Lösungen wie Praxissoftware (z.B. CGM, Medistar) oder Handwerkersoftware. Wir entwickeln bei Bedarf auch Custom-Integrationen für Ihre speziellen Systeme.
            </div>
          </details>

          <details open class="group p-6 rounded-2xl border border-border bg-card backdrop-blur-sm">
            <summary class="cursor-pointer font-bold text-lg text-foreground list-none flex items-center justify-between">
              <span>Was kostet eine KI-Rezeption?</span>
              <span class="transition-transform group-open:rotate-180">▼</span>
            </summary>
            <div class="mt-4 text-muted-foreground">
              Die Kosten hängen vom Anrufvolumen und der Komplexität ab. Unsere Lösungen starten bei 299€/Monat für kleine Unternehmen. Im Vergleich zu einer Vollzeit-Rezeptionskraft (40.000€+/Jahr) sparen Sie typischerweise 70-80% – bei besserer Erreichbarkeit. Der ROI ist meist nach 2-3 Monaten erreicht.
            </div>
          </details>

          <details open class="group p-6 rounded-2xl border border-border bg-card backdrop-blur-sm">
            <summary class="cursor-pointer font-bold text-lg text-foreground list-none flex items-center justify-between">
              <span>Kann die KI auch ausgehende Anrufe tätigen?</span>
              <span class="transition-transform group-open:rotate-180">▼</span>
            </summary>
            <div class="mt-4 text-muted-foreground">
              Ja! Die KI kann automatisch Terminerinnerungen anrufen, Bestätigungen einholen oder Follow-up-Gespräche führen. Das ist besonders wertvoll für Praxen (Terminerinnerung) oder Vertrieb (Lead-Qualifizierung). Alles natürlich unter Beachtung der rechtlichen Vorgaben.
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          Verpassen Sie nie wieder einen Anruf.
        </h2>
        <p class="text-xl text-muted-foreground mb-8">
          Ihre Kunden erwarten Erreichbarkeit. Lassen Sie uns gemeinsam eine KI-Rezeption implementieren, die Ihre Anrufer begeistert – 24/7, ohne Pause, ohne Ausfälle.
        </p>
        <a href="#kontakt" class="inline-flex items-center justify-center px-8 py-4 rounded-lg bg-primary text-primary-foreground hover:from-green-600 hover:to-orange-500 transition-all text-lg font-semibold shadow-lg">
          Kostenlose Demo vereinbaren
        </a>
      </div>
    </section>

    <!-- Contact -->
    <div id="kontakt">
      <Contact client:load />
    </div>
  </main>

  <Footer />
</Layout>
