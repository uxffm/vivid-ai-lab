---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation';
import Contact from '../components/Contact';
import Footer from '../components/Footer.astro';

const pageTitle = "ChatGPT Ads Agentur – KI-Sichtbarkeit für Ihre Marke | Frankfurt AI";
const pageDescription = "Als spezialisierte ChatGPT Ads Agentur sorgen wir dafür, dass Ihre Marke dort auftaucht, wo Ihre Kunden heute wirklich nach Empfehlungen suchen – in der KI-Suche.";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "ChatGPT Ads Agentur",
  "name": "ChatGPT Ads Agentur Frankfurt",
  "description": pageDescription,
  "provider": {
    "@type": "Organization",
    "name": "KI Frankfurt",
    "url": "https://frankfurt-ai.de",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Frankfurt am Main",
      "addressRegion": "Hessen",
      "addressCountry": "DE"
    }
  },
  "areaServed": {
    "@type": "Country",
    "name": "Deutschland"
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image="/src/assets/ai-hero-image.jpg"
  type="website"
  customSchema={serviceSchema}
>
  <Navigation client:load />

  <!-- Breadcrumbs -->
  <nav class="pt-32 pb-4" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-6">
      <ol class="flex items-center gap-2 text-sm text-muted-foreground" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" itemprop="item" class="hover:text-foreground transition-colors">
            <span itemprop="name">Home</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <li aria-hidden="true">/</li>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span itemprop="name" class="text-foreground">ChatGPT Ads Agentur</span>
          <meta itemprop="position" content="2" />
        </li>
      </ol>
    </div>
  </nav>

  <main>
    <!-- Hero -->
    <section class="relative min-h-screen flex items-center overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-400/20 via-purple-400/15 to-transparent" />
      <div class="pointer-events-none absolute -top-24 -left-24 h-64 w-64 rounded-full bg-blue-500/10 blur-2xl" />
      <div class="pointer-events-none absolute -bottom-24 -right-24 h-64 w-64 rounded-full bg-purple-400/10 blur-2xl" />

      <div class="relative z-10 max-w-7xl mx-auto px-6">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-4xl md:text-6xl font-bold leading-tight">
            Ihre ChatGPT Ads Agentur für Sichtbarkeit in der KI-Suche
          </h1>
          <p class="mt-6 text-lg md:text-xl text-muted-foreground">
            Immer mehr Menschen fragen ChatGPT statt Google. Als spezialisierte ChatGPT Ads Agentur sorgen wir dafür, dass Ihre Marke dort auftaucht, wo Ihre Kunden heute wirklich nach Empfehlungen suchen.
          </p>
          <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
            <a href="#kontakt" class="inline-flex items-center justify-center px-6 py-3 rounded-[5px] bg-gradient-to-r from-blue-500 to-purple-500 text-white hover:from-blue-600 hover:to-purple-600 transition-colors">
              Kostenlose Analyse sichern
            </a>
            <a href="#so-funktionierts" class="inline-flex items-center justify-center px-6 py-3 rounded-[5px] border border-border hover:bg-muted transition-colors">
              So funktioniert's
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Das Problem -->
    <section class="py-16 bg-gradient-to-b from-blue-400/5 via-purple-400/5 to-transparent">
      <div class="max-w-3xl mx-auto px-6">
        <div class="rounded-2xl border border-border/60 bg-gradient-to-br from-background/80 to-background/60 backdrop-blur-sm p-8 shadow-lg text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground mb-4">Das Problem</p>
          <h2 class="text-2xl md:text-3xl font-semibold mb-4">
            Die Suche hat sich verändert. Ihre Werbung noch nicht.
          </h2>
          <p class="text-lg text-muted-foreground">
            Früher ging es darum, bei Google auf Seite 1 zu ranken. Heute stellt Ihr Kunde eine Frage — und ChatGPT gibt eine Antwort. Ob Ihre Marke darin vorkommt, ist kein Zufall. Genau hier setzt eine ChatGPT Ads Agentur an.
          </p>
        </div>
      </div>
    </section>

    <!-- Die Lösung -->
    <section class="py-16 bg-gradient-to-b from-purple-400/5 via-blue-400/5 to-transparent">
      <div class="max-w-3xl mx-auto px-6">
        <div class="rounded-2xl border border-border/60 bg-gradient-to-br from-background/80 to-background/60 backdrop-blur-sm p-8 shadow-lg text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground mb-4">Die Lösung</p>
          <h2 class="text-2xl md:text-3xl font-semibold mb-4">
            Wir machen Sie zur Antwort, die ChatGPT gibt.
          </h2>
          <p class="text-lg text-muted-foreground">
            So wie SEO und Google Ads eine ganze Generation von Marken groß gemacht haben, entscheidet KI-Werbung über die nächsten zehn Jahre. Als ChatGPT Ads Agentur bringen wir Sie mit einem klaren, messbaren System genau dorthin.
          </p>
        </div>
      </div>
    </section>

    <!-- Was ChatGPT Ads bedeutet -->
    <section class="py-16 bg-gradient-to-b from-blue-400/5 via-purple-400/5 to-transparent">
      <div class="max-w-3xl mx-auto px-6">
        <div class="rounded-2xl border border-border/60 bg-gradient-to-br from-background/80 to-background/60 backdrop-blur-sm p-8 shadow-lg">
          <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground mb-4">Was „ChatGPT Ads" bei uns bedeutet</p>
          <h2 class="text-2xl md:text-3xl font-semibold mb-6">
            Kurz gesagt: Es geht nicht um Anzeigen — es geht um Empfehlungen.
          </h2>
          <div class="space-y-4 text-lg text-muted-foreground">
            <p>
              In ChatGPT gibt es keine klassischen Werbeplätze wie bei Google. Sichtbarkeit entsteht anders: durch die Inhalte, Daten und Signale, aus denen KI-Modelle ihre Antworten bauen. Genau daran arbeiten wir.
            </p>
            <p>
              Wir sorgen dafür, dass ChatGPT Ihre Marke kennt, versteht und empfiehlt, wenn jemand nach einer Lösung wie Ihrer fragt. Manche nennen das GEO (Generative Engine Optimization) — wir nennen es einfach: die Arbeit, die Sie zur Antwort macht.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- So funktioniert's -->
    <section id="so-funktionierts" class="py-16 bg-gradient-to-b from-blue-400/5 via-purple-400/5 to-transparent">
      <div class="max-w-5xl mx-auto px-6">
        <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground text-center mb-4">So funktioniert's</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-lg border border-border bg-white/60 dark:bg-white/5">
            <div class="text-sm font-semibold text-muted-foreground mb-1">Schritt 1</div>
            <h3 class="text-2xl font-semibold mb-3">Analyse</h3>
            <p class="text-muted-foreground">
              Wir prüfen, wie ChatGPT aktuell über Sie, Ihre Branche und Ihre Wettbewerber spricht — und wo Ihre größten Chancen liegen.
            </p>
          </div>
          <div class="p-6 rounded-lg border border-border bg-white/60 dark:bg-white/5">
            <div class="text-sm font-semibold text-muted-foreground mb-1">Schritt 2</div>
            <h3 class="text-2xl font-semibold mb-3">Kampagne & Optimierung</h3>
            <p class="text-muted-foreground">
              Wir setzen Ihre Inhalte und Kampagnen so auf, dass KI-Modelle Sie verstehen und empfehlen. Was eine gute ChatGPT Ads Agentur ausmacht, ist genau diese Arbeit im Detail.
            </p>
          </div>
          <div class="p-6 rounded-lg border border-border bg-white/60 dark:bg-white/5">
            <div class="text-sm font-semibold text-muted-foreground mb-1">Schritt 3</div>
            <h3 class="text-2xl font-semibold mb-3">Wachstum</h3>
            <p class="text-muted-foreground">
              Wir tracken Ihre Nennungen, optimieren laufend nach und bauen Ihren Vorsprung kontinuierlich aus.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Was Sie bekommen -->
    <section class="py-16 bg-gradient-to-b from-blue-400/5 via-purple-400/5 to-transparent">
      <div class="max-w-5xl mx-auto px-6">
        <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground text-center mb-4">Was Sie bekommen</p>
        <h2 class="text-2xl md:text-3xl font-semibold text-center mb-8">Konkret arbeiten wir an drei Hebeln.</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-lg border border-border bg-white/60 dark:bg-white/5">
            <h3 class="text-xl font-semibold mb-3">Sichtbarkeits-Audit</h3>
            <p class="text-muted-foreground text-sm">
              Wir testen mit hunderten realen Fragen, wie ChatGPT, Gemini & Perplexity heute über Sie und Ihre Wettbewerber sprechen — inklusive Baseline, wo Sie gerade stehen.
            </p>
          </div>
          <div class="p-6 rounded-lg border border-border bg-white/60 dark:bg-white/5">
            <h3 class="text-xl font-semibold mb-3">Content & Daten</h3>
            <p class="text-muted-foreground text-sm">
              Wir bauen und optimieren die Inhalte, strukturierten Daten und externen Quellen, aus denen KI-Modelle ihre Antworten ziehen — damit Ihre Marke als vertrauenswürdige Empfehlung auftaucht.
            </p>
          </div>
          <div class="p-6 rounded-lg border border-border bg-white/60 dark:bg-white/5">
            <h3 class="text-xl font-semibold mb-3">Monitoring & Reporting</h3>
            <p class="text-muted-foreground text-sm">
              Sie bekommen ein Dashboard mit Ihren Nennungen: bei welchen Fragen Sie empfohlen werden, wie sich das über die Zeit entwickelt und wo der nächste Hebel liegt.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Für wen -->
    <section class="py-16 bg-gradient-to-b from-purple-400/5 via-blue-400/5 to-transparent">
      <div class="max-w-5xl mx-auto px-6">
        <div class="rounded-2xl border border-border/60 bg-gradient-to-br from-background/80 to-background/60 backdrop-blur-sm p-8 shadow-lg">
          <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground mb-4">Für wen</p>
          <h2 class="text-2xl md:text-3xl font-semibold mb-8">Passt zu Ihnen, wenn …</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <ul class="space-y-4">
              <li class="flex gap-3 text-muted-foreground">
                <span class="text-green-500 font-bold mt-0.5">✓</span>
                <span>Sie in einer Branche sind, in der Menschen aktiv nach Anbietern, Tools oder Lösungen suchen</span>
              </li>
              <li class="flex gap-3 text-muted-foreground">
                <span class="text-green-500 font-bold mt-0.5">✓</span>
                <span>Google-SEO Sie bisher weitergebracht hat — und Sie den nächsten Kanal früh besetzen wollen</span>
              </li>
              <li class="flex gap-3 text-muted-foreground">
                <span class="text-green-500 font-bold mt-0.5">✓</span>
                <span>Sie messbare Ergebnisse wollen statt vager „Wir machen was mit KI"-Versprechen</span>
              </li>
            </ul>
            <div class="p-5 rounded-lg border border-border bg-muted/30">
              <p class="text-sm font-semibold text-muted-foreground mb-2">Wahrscheinlich noch nicht das Richtige, wenn …</p>
              <p class="text-muted-foreground text-sm">
                … Sie sofortige Verkäufe über Paid Ads suchen. KI-Sichtbarkeit ist ein Vorsprung, der aufgebaut wird — kein Ad-Konto, das man morgen anschaltet.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Warum wir -->
    <section class="py-16 bg-gradient-to-b from-purple-400/5 via-blue-400/5 to-transparent">
      <div class="max-w-6xl mx-auto px-6">
        <div class="rounded-2xl border border-border/60 bg-gradient-to-br from-background/80 to-background/60 backdrop-blur-sm p-8 shadow-lg">
          <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground mb-4">Warum wir</p>
          <h2 class="text-2xl md:text-3xl font-semibold mb-6">
            Die ChatGPT Ads Agentur, die sich auf nichts anderes konzentriert.
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="p-5 rounded-lg border border-border bg-white/60 dark:bg-white/5">
              <h3 class="font-semibold mb-2">Fokus statt Bauchladen</h3>
              <p class="text-muted-foreground text-sm">Wir machen KI-Sichtbarkeit und ChatGPT-Werbung, sonst nichts.</p>
            </div>
            <div class="p-5 rounded-lg border border-border bg-white/60 dark:bg-white/5">
              <h3 class="font-semibold mb-2">Messbar</h3>
              <p class="text-muted-foreground text-sm">Sie sehen schwarz auf weiß, wo und wie oft Sie empfohlen werden.</p>
            </div>
            <div class="p-5 rounded-lg border border-border bg-white/60 dark:bg-white/5">
              <h3 class="font-semibold mb-2">Vorsprung</h3>
              <p class="text-muted-foreground text-sm">Wir arbeiten am Puls der Modelle, nicht mit den Regeln von gestern.</p>
            </div>
          </div>
          <p class="text-lg text-muted-foreground">
            Anders als eine klassische Werbeagentur denkt eine spezialisierte ChatGPT Ads Agentur von Anfang an in KI-Antworten statt in Anzeigenplätzen.
          </p>
        </div>
      </div>
    </section>

    <!-- Social Proof -->
    <section class="py-16 bg-gradient-to-b from-blue-400/5 to-transparent">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <div class="rounded-2xl border border-border/60 bg-gradient-to-br from-background/80 to-background/60 backdrop-blur-sm p-8 shadow-lg">
          <blockquote class="text-lg md:text-xl text-muted-foreground italic mb-4">
            „Seit der Zusammenarbeit werden wir in ChatGPT konstant empfohlen, wenn Kunden nach Anbietern in unserer Branche fragen. Das hat echte Anfragen gebracht."
          </blockquote>
          <cite class="text-sm font-semibold text-foreground not-italic">— [Name], [Firma]</cite>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 bg-gradient-to-b from-blue-400/5 via-purple-400/5 to-transparent">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground text-center mb-4">FAQ</p>
        <div class="space-y-4">
          <details class="rounded-lg border border-border bg-white/60 dark:bg-white/5 p-5 group">
            <summary class="font-semibold cursor-pointer list-none flex justify-between items-center">
              Kann man in ChatGPT überhaupt Werbung schalten?
              <span class="text-muted-foreground text-lg">+</span>
            </summary>
            <p class="mt-3 text-muted-foreground text-sm">
              Aktuell gibt es keine klassischen Anzeigenplätze wie bei Google Ads. Sichtbarkeit in ChatGPT entsteht über die Inhalte und Signale, aus denen die KI ihre Antworten bildet. Genau darauf sind wir spezialisiert.
            </p>
          </details>
          <details class="rounded-lg border border-border bg-white/60 dark:bg-white/5 p-5">
            <summary class="font-semibold cursor-pointer list-none flex justify-between items-center">
              Wie schnell sehe ich Ergebnisse?
              <span class="text-muted-foreground text-lg">+</span>
            </summary>
            <p class="mt-3 text-muted-foreground text-sm">
              Erste Bewegungen sind oft nach 4–8 Wochen messbar. Ein stabiler Vorsprung baut sich über 3–6 Monate auf — ähnlich wie bei SEO, nur früher im Zyklus.
            </p>
          </details>
          <details class="rounded-lg border border-border bg-white/60 dark:bg-white/5 p-5">
            <summary class="font-semibold cursor-pointer list-none flex justify-between items-center">
              Wie messt ihr, ob es funktioniert?
              <span class="text-muted-foreground text-lg">+</span>
            </summary>
            <p class="mt-3 text-muted-foreground text-sm">
              Wir tracken, bei welchen realen Nutzerfragen Ihre Marke genannt wird, und zeigen die Entwicklung in einem Dashboard. Sie sehen schwarz auf weiß, wo Sie vorher standen und wo Sie jetzt stehen.
            </p>
          </details>
          <details class="rounded-lg border border-border bg-white/60 dark:bg-white/5 p-5">
            <summary class="font-semibold cursor-pointer list-none flex justify-between items-center">
              Ersetzt das mein bestehendes SEO / Google Ads?
              <span class="text-muted-foreground text-lg">+</span>
            </summary>
            <p class="mt-3 text-muted-foreground text-sm">
              Nein — es ergänzt sie. KI-Suche ist ein zusätzlicher Kanal, der gerade an Bedeutung gewinnt. Wer beides bespielt, ist am besten aufgestellt.
            </p>
          </details>
          <details class="rounded-lg border border-border bg-white/60 dark:bg-white/5 p-5">
            <summary class="font-semibold cursor-pointer list-none flex justify-between items-center">
              Gibt es eine Mindestlaufzeit?
              <span class="text-muted-foreground text-lg">+</span>
            </summary>
            <p class="mt-3 text-muted-foreground text-sm">
              Wir starten mit einem Monat Audit, danach flexibel monatlich kündbar.
            </p>
          </details>
          <details class="rounded-lg border border-border bg-white/60 dark:bg-white/5 p-5">
            <summary class="font-semibold cursor-pointer list-none flex justify-between items-center">
              Was kostet das?
              <span class="text-muted-foreground text-lg">+</span>
            </summary>
            <p class="mt-3 text-muted-foreground text-sm">
              Der Umfang hängt von Ihrer Branche und Ausgangslage ab. Im kostenlosen Erstgespräch bekommen Sie eine konkrete Einschätzung.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- Abschluss-CTA -->
    <section class="py-16 bg-gradient-to-b from-purple-400/5 via-blue-400/5 to-transparent">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-2xl md:text-3xl font-semibold mb-4">Finden Sie heraus, ob ChatGPT Sie schon kennt.</h2>
        <p class="text-lg text-muted-foreground mb-3">
          Im kostenlosen 20-Minuten-Gespräch zeigen wir Ihnen live, wie ChatGPT aktuell über Sie und Ihre Wettbewerber spricht — und was Ihr größter Hebel ist.
        </p>
        <p class="text-muted-foreground mb-2">
          Unverbindlich, keine Vertragsbindung, kein Verkaufsdruck. Sie gehen mit konkreten Erkenntnissen raus, egal ob wir zusammenarbeiten oder nicht.
        </p>
        <p class="text-sm text-muted-foreground mb-8">Wir melden uns innerhalb von 24 Stunden.</p>
        <a href="#kontakt" class="inline-flex items-center justify-center px-8 py-4 rounded-[5px] bg-gradient-to-r from-blue-500 to-purple-500 text-white hover:from-blue-600 hover:to-purple-600 transition-colors text-lg">
          Jetzt kostenlose Analyse sichern
        </a>
      </div>
    </section>

    <!-- Kontakt -->
    <div id="kontakt">
      <Contact client:load />
    </div>
  </main>

  <Footer />
</Layout>
